# Copy this file to .env and fill in your values.
# For LOCAL DEVELOPMENT — FLASK_ENV=development disables the production secret guard.
FLASK_ENV=development
SECRET_KEY=smartfulfill-super-secret-dev-key
JWT_SECRET_KEY=jwt-smartfulfill-dev-key

# PORT: Do NOT set this on Render — Render injects $PORT automatically.
# For local dev, run.py defaults to 5000 if PORT is not set.
# Only set PORT here if you need to override the local default (e.g. PORT=8080).
# PORT=5000

DATABASE_URL=sqlite:///smartfulfill.db
GEMINI_API_KEY=
# Set to your deployed frontend URL in production (leave blank for local dev)
FRONTEND_URL=
