# =========================================================================
# VITE_API_URL
# =========================================================================
# 1. For Local Development: 
#    Leave this empty or set it to http://127.0.0.1:5000
# 
# 2. For Render Deployment: 
#    You DO NOT need to add your Render URL to this file. 
#    Instead, go to your Render Dashboard -> Your Frontend Service -> Environment.
#    Add a new Environment Variable there:
#    Key: VITE_API_URL
#    Value: https://your-backend-service-name.onrender.com (e.g., https://smartfulfill-api.onrender.com)
VITE_API_URL=
